{
  "$comment": "Console Editorial design tokens. tokens.css is the artifact consumers load; this file carries the same values for non-CSS consumers and for the contrast validator. Dark is canonical.",
  "name": "console-editorial",
  "type": {
    "fontDisplay": "\"Newsreader\", Georgia, \"Times New Roman\", serif",
    "fontBody": "\"Newsreader\", Georgia, \"Times New Roman\", serif",
    "fontMono": "\"IBM Plex Mono\", ui-monospace, \"SF Mono\", Menlo, monospace",
    "googleFonts": "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Newsreader:opsz,wght@6..72,300;6..72,400;6..72,450;6..72,500;6..72,600&display=swap",
    "measure": "64ch",
    "sizeBody": "18px",
    "lineHeightBody": 1.72,
    "sizeH1": "40px",
    "lineHeightH1": 1.12,
    "trackingH1": "-0.012em",
    "weightH1": 400,
    "sizeH2": "23px",
    "weightH2": 500,
    "sizeH3": "19px",
    "sizeSmall": "13px",
    "sizeLabel": "10.5px",
    "trackingLabel": "0.11em"
  },
  "shape": {
    "radius": "2px",
    "rule": "1px",
    "space": ["4px", "8px", "14px", "22px", "34px", "52px"]
  },
  "themes": {
    "dark": {
      "canonical": true,
      "weightBody": 450,
      "bg": "#0c0f13",
      "surface": "#141920",
      "raised": "#1c232c",
      "ink": "#dce3ec",
      "muted": "#8b97a6",
      "border": "#242c36",
      "accent": "#3fd0c9",
      "accentSoft": "#10262a",
      "accentInk": "#06201f",
      "ok": "#3fb950",
      "warn": "#d29922",
      "crit": "#f85149"
    },
    "light": {
      "canonical": false,
      "weightBody": 400,
      "bg": "#f5f7f9",
      "surface": "#ffffff",
      "raised": "#eef2f5",
      "ink": "#131920",
      "muted": "#5c6773",
      "border": "#dbe1e8",
      "accent": "#10736d",
      "accentSoft": "#e0f3f1",
      "accentInk": "#ffffff",
      "ok": "#1a7f37",
      "warn": "#8a5c00",
      "crit": "#cf222e"
    }
  },
  "severityScope": {
    "attribute": "data-severity-ui",
    "appliesTo": ["incident", "runbook", "status"],
    "note": "Severity tokens resolve to --dx-ink outside this scope, so a reference or explanation page cannot render severity colour even if it asks for it. Colour never carries status alone; pair with a stripe, chip, or label."
  },
  "contrastPairs": [
    { "fg": "ink", "bg": "bg", "min": 4.5, "role": "body text" },
    { "fg": "ink", "bg": "surface", "min": 4.5, "role": "body on surface" },
    { "fg": "ink", "bg": "raised", "min": 4.5, "role": "body on raised" },
    { "fg": "muted", "bg": "bg", "min": 4.5, "role": "secondary text" },
    { "fg": "muted", "bg": "raised", "min": 4.5, "role": "labels on raised" },
    { "fg": "accent", "bg": "bg", "min": 4.5, "role": "links" },
    { "fg": "accent", "bg": "surface", "min": 4.5, "role": "links on surface" },
    { "fg": "accent", "bg": "accentSoft", "min": 4.5, "role": "callout label" },
    { "fg": "ok", "bg": "raised", "min": 4.5, "role": "healthy chip" },
    { "fg": "warn", "bg": "raised", "min": 4.5, "role": "degraded chip" },
    { "fg": "crit", "bg": "raised", "min": 4.5, "role": "failed chip" },
    { "fg": "ok", "bg": "bg", "min": 4.5, "role": "healthy on ground" },
    { "fg": "warn", "bg": "bg", "min": 4.5, "role": "degraded on ground" },
    { "fg": "crit", "bg": "bg", "min": 4.5, "role": "failed on ground" },
    { "fg": "accentInk", "bg": "accent", "min": 4.5, "role": "text on accent fill" }
  ]
}
